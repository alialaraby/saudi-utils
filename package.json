{
  "name": "saudi-utils",
  "version": "0.1.0",
  "description": "Strict Saudi identity, IBAN, business, telecom, and address validation utilities",
  "keywords": [
    "saudi",
    "saudi-arabia",
    "ksa",
    "validation",
    "national-id",
    "iqama",
    "iban",
    "zatca",
    "national-address",
    "typescript"
  ],
  "author": "Ali Alaraby",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alialaraby/saudi-utils.git"
  },
  "bugs": {
    "url": "https://github.com/alialaraby/saudi-utils/issues"
  },
  "homepage": "https://github.com/alialaraby/saudi-utils#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "scripts": {
    "clean": "node --eval \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'coverage']) rmSync(path, { recursive: true, force: true });\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "npm run build && tsc --project tsconfig.examples.json --noEmit && node examples/quick-start.ts && node scripts/check-doc-links.mjs",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "pack:dry-run": "npm pack --dry-run --json",
    "pack:check": "node scripts/check-package-contents.mjs",
    "pack:consumers": "node scripts/check-packed-consumers.mjs",
    "package:check": "npm run build && npm run publint && npm run attw && npm run pack:check && npm run pack:consumers",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
